# Copy this file to .env.local and fill in the values. .env.local is never committed.

# Postgres connection URL, for example from Neon (neon.tech) or Supabase (Project settings > Database).
DATABASE_URL=postgres://user:password@host:5432/codly

# Signs session cookies. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# The address the app runs at. Change it to your real domain when you deploy.
BETTER_AUTH_URL=http://localhost:3000

# Needed for the AI Tutor.
ANTHROPIC_API_KEY=
